  class << self
    # source://sinatra-3.2.0/lib/sinatra/base.rb:453
    def defer(*_arg0); end

    # source://sinatra-3.2.0/lib/sinatra/base.rb:452
    def schedule(*_arg0); end
  end
end

# A poor man's ActiveSupport::HashWithIndifferentAccess, with all the Rails-y
# stuff removed.
#
# Implements a hash where keys <tt>:foo</tt> and <tt>"foo"</tt> are
# considered to be the same.
#
#   rgb = Sinatra::IndifferentHash.new
#
#   rgb[:black]    =  '#000000' # symbol assignment
#   rgb[:black]  # => '#000000' # symbol retrieval
#   rgb['black'] # => '#000000' # string retrieval
#
#   rgb['white']   =  '#FFFFFF' # string assignment
#   rgb[:white]  # => '#FFFFFF' # symbol retrieval
#   rgb['white'] # => '#FFFFFF' # string retrieval
#
# Internally, symbols are mapped to strings when used as keys in the entire
# writing interface (calling e.g. <tt>[]=</tt>, <tt>merge</tt>). This mapping
# belongs to the public interface. For example, given:
#
#   hash = Sinatra::IndifferentHash.new
#   hash[:a] = 1
#
# You are guaranteed that the key is returned as a string:
#
#   hash.keys # => ["a"]
#
# Technically other types of keys are accepted:
#
#   hash = Sinatra::IndifferentHash
#   hash[:a] = 1
#   hash[0] = 0
#   hash # => { "a"=>1, 0=>0 }
#
# But this class is intended for use cases where strings or symbols are the
# expected keys and it is convenient to understand both as the same. For
# example the +params+ hash in Sinatra.
#
# source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:41
class Sinatra::IndifferentHash < ::Hash
  # @return [IndifferentHash] a new instance of IndifferentHash
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:46
  def initialize(*args); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:76
  def [](key); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:80
  def []=(key, value); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:62
  def assoc(key); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:187
  def compact; end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:52
  def default(*args); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:58
  def default=(value); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:104
  def delete(key); end

  # Added in Ruby 2.3
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:109
  def dig(key, *other_keys); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:70
  def fetch(key, *args); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:113
  def fetch_values(*keys); end

  # @return [Boolean]
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:90
  def has_key?(key); end

  # @return [Boolean]
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:98
  def has_value?(value); end

  # @return [Boolean]
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:90
  def include?(key); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:86
  def key(value); end

  # @return [Boolean]
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:90
  def key?(key); end

  # @return [Boolean]
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:90
  def member?(key); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:149
  def merge(*other_hashes, &block); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:131
  def merge!(*other_hashes); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:66
  def rassoc(value); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:181
  def reject(*args, &block); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:153
  def replace(other_hash); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:175
  def select(*args, &block); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:119
  def slice(*keys); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:80
  def store(key, value); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:166
  def transform_keys(&block); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:170
  def transform_keys!; end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:157
  def transform_values(&block); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:161
  def transform_values!; end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:131
  def update(*other_hashes); end

  # @return [Boolean]
  #
  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:98
  def value?(value); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:125
  def values_at(*keys); end

  private

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:199
  def convert_key(key); end

  # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:203
  def convert_value(value); end

  class << self
    # source://sinatra-3.2.0/lib/sinatra/indifferent_hash.rb:42
    def [](*args); end
  end
end

