    # This class method is the single entry point for the <tt>rails notes</tt> command.
    #
    # pkg:gem/railties#lib/rails/source_annotation_extractor.rb:76
    def enumerate(tag = T.unsafe(nil), options = T.unsafe(nil)); end
  end
