# The Processor is a standalone thread which:
#
# 1. fetches a job from Redis
# 2. executes the job
#   a. instantiate the job class
#   b. run the middleware chain
#   c. call #perform
#
# A Processor can exit due to shutdown or due to
# an error during job execution.
#
# If an error occurs in the job execution, the
# Processor calls the Manager to create a new one
# to replace itself and exits.
#
# pkg:gem/sidekiq#lib/sidekiq/processor.rb:24
class Sidekiq::Processor
  include ::Sidekiq::Component

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:31
  def initialize(capsule, &block); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:29
  def capsule; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:28
  def job; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:49
  def kill(wait = T.unsafe(nil)); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:65
  def start; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:61
  def stopping?; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:43
  def terminate(wait = T.unsafe(nil)); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:27
  def thread; end

  private

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:122
  def dispatch(job_hash, queue, jobstr); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:219
  def execute_job(instance, cloned_args); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:102
  def fetch; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:90
  def get_one; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:112
  def handle_fetch_exception(ex); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:159
  def process(uow); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:84
  def process_one(&block); end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:71
  def run; end

  # pkg:gem/sidekiq#lib/sidekiq/processor.rb:277
  def stats(jobstr, queue); end
end

