# The Launcher starts the Capsule Managers, the Poller thread and provides the process heartbeat.
#
# pkg:gem/sidekiq#lib/sidekiq/launcher.rb:10
class Sidekiq::Launcher
  include ::Sidekiq::Component

  # pkg:gem/sidekiq#lib/sidekiq/launcher.rb:25
  def initialize(config, embedded: T.unsafe(nil)); end

  # If embedding Sidekiq, you can have the process heartbeat
  # call this method to regularly heartbeat rather than creating
  # a separate thread.
  #
  # pkg:gem/sidekiq#lib/sidekiq/launcher.rb:80
  def heartbeat; end

  # pkg:gem/sidekiq#lib/sidekiq/launcher.rb:23
  def managers; end

  # pkg:gem/sidekiq#lib/sidekiq/launcher.rb:23
  def managers=(_arg0); end

  # pkg:gem/sidekiq#lib/sidekiq/launcher.rb:23
  def poller; end

  # pkg:gem/sidekiq#lib/sidekiq/launcher.rb:23
  def poller=(_arg0); end

  # Stops this instance from processing any more jobs,
  #
