  # @return [Hash] Filtered parameters with sensitive data removed
  #
  # source://sentry-rails-6.7.0/lib/sentry/rails/log_subscribers/parameter_filter.rb:41
  def filter_sensitive_params(params); end

  class << self
    # source://sentry-rails-6.7.0/lib/sentry/rails/log_subscribers/parameter_filter.rb:28
    def backend; end
  end
end

