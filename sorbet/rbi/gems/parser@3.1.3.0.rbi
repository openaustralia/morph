    # If set to false (the default) the last hash argument is emitted as `hash`:
    #
    # ```
    # (send nil :foo
    #   (hash
    #     (pair
    #       (sym :bar)
    #       (int 42))))
    # ```
    #
    # If set to true it is emitted as `kwargs`:
    #
