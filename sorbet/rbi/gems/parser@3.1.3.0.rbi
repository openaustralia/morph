# @api public
#
# source://parser-3.1.3.0/lib/parser.rb:30
module Parser::Source; end

# A buffer with source code. {Buffer} contains the source code itself,
# associated location information (name and first line), and takes care
# of encoding.
#
# A source buffer is immutable once populated.
#
# @api public
#
# source://parser-3.1.3.0/lib/parser/source/buffer.rb:25
class Parser::Source::Buffer
  # @api public
  # @return [Buffer] a new instance of Buffer
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:105
  def initialize(name, first_line = T.unsafe(nil), source: T.unsafe(nil)); end

  # Convert a character index into the source to a column number.
  #
  # @api private
  # @param position [Integer]
  # @return [Integer] column
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:233
  def column_for_position(position); end

  # Convert a character index into the source to a `[line, column]` tuple.
  #
  # @api public
  # @param position [Integer]
  # @return [[Integer, Integer]] `[line, column]`
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:208
  def decompose_position(position); end

  # First line of the buffer, 1 by default.
  #
  # @api public
  # @return [Integer] first line
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:26
  def first_line; end

  # @api public
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:303
  def freeze; end

  # @api public
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:309
  def inspect; end

  # Number of last line in the buffer
  #
  # @api public
  # @return [Integer]
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:298
  def last_line; end

  # Convert a character index into the source to a line number.
  #
  # @api private
  # @param position [Integer]
  # @return [Integer] line
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:222
  def line_for_position(position); end

  # Extract line `lineno` as a new `Range`, taking `first_line` into account.
  #
  # @api public
  # @param lineno [Integer]
  # @raise [IndexError] if `lineno` is out of bounds
  # @return [Range]
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:275
  def line_range(lineno); end

  # Buffer name. If the buffer was created from a file, the name corresponds
  # to relative path to the file.
  #
  # @api public
  # @return [String] buffer name
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:26
  def name; end

  # Populate this buffer from a string without encoding autodetection.
  #
  # @api public
  # @param input [String]
  # @raise [ArgumentError] if already populated
  # @return [String]
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:180
  def raw_source=(input); end

  # Populate this buffer from correspondingly named file.
  #
  # @api public
  # @example
  #   Parser::Source::Buffer.new('foo/bar.rb').read
  # @raise [ArgumentError] if already populated
  # @return [Buffer] self
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:131
  def read; end

  # @api public
  #
  # source://parser-3.1.3.0/lib/parser/source/buffer.rb:194
  def slice(range); end

  # Source code contained in this buffer.
  #
  # @api public
  # @raise [RuntimeError] if buffer is not populated yet
  # @return [String] source code
  #
