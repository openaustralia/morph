  # @param other [Range]
  # @return [Boolean]
  #
  # source://parser-3.1.3.0/lib/parser/source/range.rb:286
  def crossing?(other); end

  # Return `true` iff this range and `other` are disjoint.
  #
  # Two ranges must be one and only one of ==, disjoint?, contains?, contained? or crossing?
  #
  # @api public
  # @param other [Range]
  # @return [Boolean]
  #
  # source://parser-3.1.3.0/lib/parser/source/range.rb:236
  def disjoint?(other); end

