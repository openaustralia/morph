  # @return [Integer]
  #
  # source://parser-3.1.3.0/lib/parser/source/map.rb:109
  def column; end

  # @api public
  # @return [Range]
  #
  # source://parser-3.1.3.0/lib/parser/source/map.rb:72
  def expression; end

  # A shortcut for `self.expression.line`.
  #
  # @api public
  # @return [Integer]
  #
  # source://parser-3.1.3.0/lib/parser/source/map.rb:99
  def first_line; end

  # A shortcut for `self.expression.last_column`.
  #
  # @api public
  # @return [Integer]
  #
  # source://parser-3.1.3.0/lib/parser/source/map.rb:125
  def last_column; end

  # A shortcut for `self.expression.last_line`.
