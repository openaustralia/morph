%div{ id: "owner_#{owner.nickname}_content" }
  %p
    %i.fa.fa-2x.fa-spin{ class: "fa-#{forge.key}" }
    Hang on. Getting your repositories from #{forge.name}&hellip;
:javascript
  $(document).ready(function(){
    $("#owner_#{owner.nickname}_content").load("#{forge_form_path(forge, owner)}")
  });
