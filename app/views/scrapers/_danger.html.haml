- if can? :destroy, scraper
  %h2 Danger Zone
  .row
    .col-md-8
      .panel.panel-danger#danger-settings
        .panel-heading
          %p
            %strong Be careful, these actions can’t be undone.
        %ul.danger-settings-options-list.list-group
          %li.list-group-item
            %h3 Clear your scraper’s database
            .danger-settings-action-body
              %p
                - if scraper.data?
                  Your
                  = pluralize(scraper.sqlite_total_rows, "row")
                  of scraped data will be gone!
                - else
                  All your data will be gone!
              = button_to clear_scraper_path(scraper), { class: "btn btn-danger", data: { confirm: "All the data you’ve scraped will be deleted. Are you sure you want to clear your scraper’s database?" } } do
                Clear database
                %i.glyphicon.glyphicon-th-list
          - if can? :create_private, scraper
            %li.list-group-item
              = render "shared/special_feature_panel" do
                %h3 Change scraper and repository visibility
                .danger-settings-action-body
                  %p
                    Your scraper and repository are currently
                    = privacy_in_words(scraper.private)
                  = button_to toggle_privacy_scraper_path(scraper), class: "btn btn-danger" do
                    Make
                    = privacy_in_words(!scraper.private)
          - other_forges = Morph::Forge.available.select { |forge| current_user.forge_identity(forge.key) && scraper.owner.forge_identity(forge.key) }
          - unless other_forges.empty?
            %li.list-group-item
              %h3 Change repository
              .danger-settings-action-body
                %p
                  Point this scraper at a different repository, on #{scraper.forge.name} or another forge, keeping its address on #{hostname},
                  its data, its history of runs and its watchers. The repository must belong to #{scraper.owner.nickname} there.
                  The current clone is discarded and the code fetched afresh.
                - other_forges.each do |forge|
                  = form_tag change_repository_scraper_path(scraper), class: "form-inline change-repository" do
                    = hidden_field_tag :forge_key, forge.key
                    .form-group
                      %label.sr-only{ for: "full_name_#{forge.key}" } Repository on #{forge.name}
                      = text_field_tag :full_name, "#{scraper.owner.forge_identity(forge.key).login}/#{scraper.name}", id: "full_name_#{forge.key}", class: "form-control", placeholder: "owner/repository"
                    = button_tag class: "btn btn-danger", data: { confirm: "Move #{scraper.full_name} to that repository on #{forge.name}? The current clone will be discarded." } do
                      Move to #{forge.name}
                      %i.fa{ class: "fa-#{forge.key}" }
          %li.list-group-item
            %h3 Delete your scraper
            .danger-settings-action-body
              %p
                Delete the entire scraper from #{hostname},
                %em data and all.
                This will leave the repository on #{scraper.forge.name} untouched. If you want to delete the repository as well you will need to do that manually on #{scraper.forge.name}.
              = button_to scraper, { class: "btn btn-danger", method: :delete, data: { confirm: "Scraper #{scraper.full_name} and its database will be deleted from morph.io. Are you sure you want to delete your scraper?" } } do
                Delete your scraper
                %i.glyphicon.glyphicon-remove
