- forge = @forge
- title "Add scraper from your #{forge.name} repository"

.container
  %h1= title

  = render "documentation/languages"
  = render "documentation/format_intro"

  - owners = current_user.owners_on(forge)
  - if owners.empty?
    .alert.alert-info
      You have not connected a #{forge.name} account yet.
      = sign_in_with_forge_button forge, "Connect #{forge.name}", class: "btn btn-default btn-sm"
  - else
    - if forge.key == "gitlab"
      %p.text-muted
        Projects in a top-level group show under that group. Projects in subgroups cannot be added yet.

    %ul.nav.nav-tabs
      - owners.each_with_index do |owner, i|
        %li{ class: ("active" if i.zero?) }
          = link_to "#owner_#{owner.nickname}", data: { toggle: "tab" } do
            = owner_image(owner, size: 30)
            = owner.nickname

    -# This form is only here to show a possible error message
    = simple_form_for @scraper do |f|
      .has-error= f.error :full_name

    .tab-content
      - owners.each_with_index do |owner, i|
        .tab-pane{ id: "owner_#{owner.nickname}", class: ("active" if i.zero?) }
          = render partial: "github_form_loader", locals: { owner: owner, forge: forge }
